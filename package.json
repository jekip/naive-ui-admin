{
  "name": "naive-ui-admin",
  "version": "3.0.0",
  "author": {
    "name": "Ahjung",
    "email": "735878602@qq.com",
    "url": "https://github.com/jekip/naive-ui-admin"
  },
  "private": true,
  "scripts": {
    "bootstrap": "pnpm install",
    "serve": "pnpm run dev",
    "dev": "vite",
    "build": "vite build && esno ./build/script/postBuild.ts && pnpm run size",
    "build:no-cache": "pnpm clean:cache && pnpm run build",
    "size": "node scripts/report-bundle-size.mjs dist",
    "report": "cross-env ANALYZE=true vite build && pnpm run size",
    "preview": "pnpm run build && vite preview",
    "preview:dist": "vite preview",
    "clean:cache": "rimraf node_modules/.cache/ && rimraf node_modules/.vite",
    "clean:lib": "rimraf node_modules",
    "deploy": "gh-pages -d dist",
    "type-check": "vue-tsc --noEmit",
    "lint:eslint": "eslint \"{src,mock,build}/**/*.{vue,ts,tsx}\" --fix",
    "lint:prettier": "prettier --write --log-level warn \"src/**/*.{js,json,tsx,css,less,scss,vue,html,md}\"",
    "lint:stylelint": "stylelint --fix \"**/*.{vue,less,postcss,css,scss}\" --cache --cache-location node_modules/.cache/stylelint/",
    "lint:pretty": "pretty-quick --staged",
    "commit": "git-cz",
    "prepare": "husky"
  },
  "dependencies": {
    "@alova/mock": "^2.0.22",
    "@vicons/antd": "^0.13.0",
    "@vicons/ionicons5": "^0.13.0",
    "@vueup/vue-quill": "^1.2.0",
    "@vueuse/core": "^15.0.0",
    "alova": "^3.5.5",
    "date-fns": "^4.4.0",
    "echarts": "^6.1.0",
    "element-resize-detector": "^1.2.4",
    "lodash-es": "^4.17.21",
    "mockjs": "^1.1.0",
    "naive-ui": "^2.45.3",
    "pinia": "^2.3.1",
    "vue": "^3.5.44",
    "vue-i18n": "^11.4.16",
    "vue-router": "^4.6.4",
    "vuedraggable": "^4.1.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@faker-js/faker": "^10.6.0",
    "@types/fs-extra": "^11.0.4",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^24.19.2",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.72.0",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitejs/plugin-vue-jsx": "^5.1.6",
    "@vue/compiler-sfc": "^3.5.44",
    "@vue/eslint-config-typescript": "^14.9.0",
    "autoprefixer": "^10.4.21",
    "chalk": "^6.0.1",
    "commitizen": "^4.3.1",
    "cross-env": "^10.1.0",
    "cz-customizable": "^7.5.4",
    "dotenv": "^18.0.8",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.11.1",
    "esno": "^4.8.0",
    "fs-extra": "^11.4.1",
    "gh-pages": "^6.3.0",
    "husky": "^9.1.7",
    "less": "^4.9.1",
    "lint-staged": "^17.6.0",
    "postcss": "^8.5.6",
    "postcss-html": "^2.0.0",
    "postcss-less": "^6.0.0",
    "prettier": "^3.9.10",
    "pretty-quick": "^4.2.2",
    "rimraf": "^6.1.3",
    "rollup-plugin-visualizer": "^7.1.1",
    "stylelint": "^17.16.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-order": "^8.1.2",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.9.3",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^7.3.7",
    "vite-plugin-compression": "^0.5.1",
    "vite-plugin-html": "^3.2.2",
    "vue-tsc": "^3.3.13"
  },
  "lint-staged": {
    "*.{vue,js,ts,tsx}": "eslint --fix"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-customizable"
    }
  },
  "keywords": [
    "vue",
    "naive-ui",
    "naive-ui-admin",
    "vue3",
    "ts",
    "tsx",
    "admin",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jekip/naive-ui-admin.git"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/jekip/naive-ui-admin/issues"
  },
  "homepage": "https://github.com/jekip/naive-ui-admin",
  "engines": {
    "node": ">=20.19.0",
    "pnpm": ">=10"
  },
  "packageManager": "pnpm@12.11.2"
}
